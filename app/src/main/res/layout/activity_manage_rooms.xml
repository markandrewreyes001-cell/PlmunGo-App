<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/plmun"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MANAGE ROOMS"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/field_rounded_bg"
            android:elevation="5dp">

            <Spinner
                android:id="@+id/spinnerFloor"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/field_rounded_bg"/>

            <Button
                android:id="@+id/btnAddRoom"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="ADD NEW ROOM"
                android:textColor="@color/white"
                android:background="@drawable/bg_home_button"
                android:layout_marginTop="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ROOM LIST"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#333333"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/layoutRoomList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnManageBack"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="BACK"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>
